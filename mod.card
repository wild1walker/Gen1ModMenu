-- Sharing metadata read by tooling and the mod manager's detail pane; never
-- by the loader's merge.
return {
  summary = "The mod manager, redrawn: a sortable, filterable mod list and a "
    .. "per-mod OPTIONS page that shows eleven rows with their values and a "
    .. "help line instead of four bare boxes.",
  author = "wild1walker",
  contact = "https://github.com/wild1walker/Gen1ModMenu",
  tags = { "ui", "mod manager", "options", "quality-of-life" },
  differences = {
    changed = {
      "the mod list and the per-mod OPTIONS page are both banded like "
        .. "Gen1BillsBox's storage screen: a header box "
        .. "naming the page (or the mod being edited) with the position "
        .. "count beside it, the rows under it, and an info box at the "
        .. "bottom naming what the cursor is on; left and right wrap "
        .. "between the three pages",
      "MODS is drawn by this mod instead of the engine (STYLE: VANILLA hands "
        .. "every screen straight back)",
      "the mod list and the per-mod OPTIONS page are drawn as framed cards, "
        .. "the same shape the game's own OPTION screen uses, so a mod name "
        .. "and an option value are each shown in full on a line of their own",
      "the mod list can be sorted by name, enabled state or problems, and "
        .. "filtered down to the mods that have options",
      "a mod that is enabled and running carries no mark; the status is for "
        .. "the exceptions (OFF, STGD, ERR, BLKD, SKIP), and shares the "
        .. "card's second line with the mod's category",
      "no control hints on any screen: A chooses, B goes back, the d-pad "
        .. "moves, the same as every other menu in the game",
      "Gold draws the OPTIONS page from this mod rather than through "
        .. "src/ui/OptionRows.lua, which the engine itself marks Gen 1 only",
    },
    added = {
      "START on the mod list opens a menu with the focused mod's "
        .. "ENABLE/DISABLE, the four sort orders and the two filters; "
        .. "SELECT applies staged changes, which is what START used to do",
      "a row with no readable label -- a profile saved without a name -- "
        .. "reads (NO NAME) rather than drawing an empty card",
      "the START menu's MODS row is relabelled MOD MENU (the engine's own "
        .. "row, renamed rather than duplicated)",
      "CANCEL is dropped from the game's own OPTION screen on Gen 1; B and "
        .. "START already leave that menu, so it was a second exit rather "
        .. "than the only one",
      "a help line under the cards saying what the focused option accepts, "
        .. "including on the engine's own RESET DEFAULTS row",
    },
    known = {
      "the OPTION screen's CANCEL is removed on Gen 1 only -- Gold's options "
        .. "screen is a different screen with a different layout, and is "
        .. "left alone",
      "the manager's own behaviour is untouched -- enabling, dependency "
        .. "closures, profiles, apply-and-restart and safe mode are all "
        .. "still the engine's, and this mod only draws them",
      "the launcher's own mod-options screen is a different screen outside "
        .. "the game, where no mod is loaded, so it is not affected",
    },
  },
  credits = {
    { who = "Gen1Recomp", for_ = "src/mods/ManagerState.lua and the "
      .. "Data.screens registry this mod reaches it through" },
  },
  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2 },
}
